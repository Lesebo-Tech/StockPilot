
@StockPilot.Api_HostAddress = http://localhost:5164

### 1. Get all products
GET {{StockPilot.Api_HostAddress}}/api/products
Accept: application/json

### 2. Get a product by ID
GET {{StockPilot.Api_HostAddress}}/api/products/1
Accept: application/json

### 3. Create a new product
POST {{StockPilot.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Wireless Keyboard",
  "sku": "KEY-001",
  "price": 450.00,
  "quantity": 20,
  "reorderLevel": 5
}

### 4. Test duplicate SKU
POST {{StockPilot.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Another Keyboard",
  "sku": "KEY-001",
  "price": 500.00,
  "quantity": 10,
  "reorderLevel": 5
}

### 5. Test invalid price
POST {{StockPilot.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Computer Mouse",
  "sku": "MOU-001",
  "price": -50,
  "quantity": 10,
  "reorderLevel": 5
}


### Update product ID 1
PUT http://localhost:5164/api/products/1
Content-Type: application/json

{
  "name": "Wireless Gaming Keyboard",
  "sku": "KEY-001",
  "price": 599.99,
  "reorderLevel": 10
}


### Verify Product After Stock In
GET http://localhost:5164/api/products/1
Accept: application/json

### Test updating a missing product
PUT http://localhost:5164/api/products/99999
Content-Type: application/json

{
  "name": "Gaming Mouse",
  "sku": "MOU-001",
  "price": 250.00,
  "reorderLevel": 5
}


### Stock In - Receive 15 keyboards
POST http://localhost:5164/api/inventory/stock-in
Content-Type: application/json

{
  "productId": 1,
  "quantity": 15,
  "reason": "Received new stock from supplier"
}
